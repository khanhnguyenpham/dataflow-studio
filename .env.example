# Use a newly generated URL-safe password, never a credential from another project.
POSTGRES_PASSWORD=
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Hosts without a shell: optional first-admin secrets, remove after first successful setup.
# Never commit an actual password. Never resets an existing administrator.
# BOOTSTRAP_ADMIN_USER=
# BOOTSTRAP_ADMIN_PASSWORD=
